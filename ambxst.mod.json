{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/main/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "ecta250.colorbxst",
  "name": "Colorbxst",
  "version": "0.7.0",
  "description": "Makes the shell and your apps follow the theme you edit in Settings. Terminals, GTK, Qt, Discord, NvChad and Pywal take their background from the Background variant; a Terminal section in Settings > Theme edits the terminal and Pywal palette (no longer inverted in light mode). Calendar, menus, option lists, tooltips, the OSD and critical notifications, bar text and the lock screen clock follow their variant instead of fixed palette tones.",
  "license": "MIT",
  "author": "Ecta250",
  "authorUrl": "https://github.com/Ecta250",
  "homepage": "https://github.com/Ecta250/ambxst-colorbxst",
  "changelog": "CHANGELOG.md",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.15 <2.0.0",
    "testedBaseCommits": [
      "5d71e924212ce2c0203e7448e0b1e3db52608640"
    ]
  },
  "dependencies": [],
  "conflicts": [],
  "commands": [],
  "permissions": [
    "Changes the colours Ambxst writes for Ghostty, Kitty, GTK, Qt (qt5ct/qt6ct), Discord, NvChad and Pywal (same files as before)",
    "Saves the terminal colours of Settings > Theme > Terminal in ~/.config/ambxst/config/colorbxst.json (included in Ambxst presets) and reads its own mod settings"
  ],
  "localization": {
    "mode": "single",
    "defaultLanguage": "en"
  },
  "settings": {
    "schema": "settings.json"
  },
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/theme/Colorbxst.qml",
      "target": "modules/theme/Colorbxst.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/widgets/dashboard/controls/TerminalEditor.qml",
      "target": "modules/widgets/dashboard/controls/TerminalEditor.qml"
    },
    {
      "type": "patch",
      "source": "patches/terminals.patch"
    },
    {
      "type": "patch",
      "source": "patches/shell-ui.patch"
    },
    {
      "type": "patch",
      "source": "patches/settings-terminal.patch"
    },
    {
      "type": "patch",
      "source": "patches/apps.patch"
    },
    {
      "type": "patch",
      "source": "patches/notifications-fixes.patch"
    },
    {
      "type": "patch",
      "source": "patches/menus.patch"
    },
    {
      "type": "patch",
      "source": "patches/bar-lockscreen.patch"
    },
    {
      "type": "patch",
      "source": "patches/actions-toggles.patch"
    },
    {
      "type": "patch",
      "source": "patches/surfaces.patch"
    },
    {
      "type": "patch",
      "source": "patches/presets.patch"
    }
  ]
}
